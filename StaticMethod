class Employee:
    def __init__(self,name,position):
        self.name=name
        self.position=position
    def get_info(self):
        return f"{self.name} {self.position}"
    @staticmethod   #Defining a static method with the python's inbuilt decorator
    def check_position(position):
        valid_positions=["Manager","Accountant","Developer"]
        return position in valid_positions
    
e=Employee("Raj","Manager")
Employee.check_position("Janitor")   #Calling a static method(using class name)
