#Basic Dunder Methods in Python - init,str,repr
class Book:
    def __init__(self,title,author):
        self.title=title
        self.author=author
    def __str__(self):
        return f"{self.title} by {self.author}"
    def __repr__(self):
        return f"Book('{self.title}','{self.author}')"

b=Book("Atomic Habits","James Clear")
print(b)
print(str(b))
print(repr(b))
