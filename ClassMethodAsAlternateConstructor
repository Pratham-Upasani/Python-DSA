#Class methods as alternate constructors(to create objects from a different format of input data)
class Employee:
    def __init__(self,name,salary):
        self.name=name
        self.salary=salary

    @classmethod
    def ObjectFromString(cls, string):   #It means creating object from different format of data passed to it
        return cls(string.split("-")[0], string.split("-")[1])   #Read it as Employee(......), returning an object to the e2 variable

    

e1=Employee("Harry",12000)
print(e1.name)
print(e1.salary)


string="John-12000"
e2 = Employee.ObjectFromString(string)    #We are using class method instead of init to create e2 from the string input
print(e2.name)
print(e2.salary)
